@model Turismo_Bova.Models.Asignacion_Ruta_Vehiculo_Horario
@{
    ViewData["Title"] = "Nueva Asignación";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <h2 class="mb-3">Registrar asignación de ruta</h2>

    <div class="card border-success shadow">
        <div class="card-body">
            <form asp-action="Crear" method="post">
                @Html.AntiForgeryToken()

                <!-- Mostrar errores generales -->
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="FechaAsignacion" class="form-label"></label>
                    <input asp-for="FechaAsignacion" class="form-control" type="date" />
                    <span asp-validation-for="FechaAsignacion" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="VehiculoId" class="form-label">Vehículo</label>
                    <select asp-for="VehiculoId" asp-items="ViewBag.VehiculoId" class="form-select">
                        <option value="">Seleccione un vehículo</option>
                    </select>
                    <span asp-validation-for="VehiculoId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EmpleadoId" class="form-label">Empleado</label>
                    <select asp-for="EmpleadoId" asp-items="ViewBag.EmpleadoId" class="form-select">
                        <option value="">Seleccione un empleado</option>
                    </select>
                    <span asp-validation-for="EmpleadoId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="RutaId" class="form-label">Ruta</label>
                    <select asp-for="RutaId" asp-items="ViewBag.RutaId" class="form-select" id="RutaId">
                        <option value="">Seleccione una ruta</option>
                    </select>
                    <span asp-validation-for="RutaId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="HorarioId" class="form-label">Horario</label>
                    <select asp-for="HorarioId" class="form-select" id="HorarioId">
                        <option value="">Seleccione una ruta primero</option>
                    </select>
                    <span asp-validation-for="HorarioId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Estado" class="form-label"></label>
                    <input asp-for="Estado" class="form-control" placeholder="Por salir, En ruta o Completada" />
                    <span asp-validation-for="Estado" class="text-danger"></span>
                </div>

                <div class="text-end">
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-save me-1"></i> Guardar
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            $('#RutaId').change(function () {
                var rutaId = $(this).val();
                $('#HorarioId').html('<option value="">Cargando horarios...</option>');

                $.get('/Rutas/HorariosPorRuta', { rutaId: rutaId }, function (data) {
                    $('#HorarioId').html('');
                    if (data.length === 0) {
                        $('#HorarioId').append('<option value="">No hay horarios disponibles</option>');
                    } else {
                        data.forEach(h => {
                            $('#HorarioId').append(`<option value="${h.id}">${h.texto}</option>`);
                        });
                    }
                });
            });
        });
    </script>
}
