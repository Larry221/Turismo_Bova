@model List<Turismo_Bova.Models.Contrato>
@{
    ViewData["Title"] = "Contratos";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Contratos</h1>
        <a asp-action="Crear" class="btn btn-success">
            <i class="fas fa-plus"></i> Nuevo Contrato
        </a>
    </div>

    <div class="card border-primary">
        <div class="card-body">
            <table id="tablaContratos" class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Cliente</th>
                        <th>Servicio</th>
                        <th>Fecha Inicio</th>
                        <th>Fecha Fin</th>
                        <th>Estado</th>
                        <th>Precio Total</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>@c.cliente?.RazonSocial</td>
                            <td>@c.servicio?.Nombre</td>
                            <td>@c.FechaInicio</td>
                            <td>@c.FechaFin</td>
                            <td>@c.Estado</td>
                            <td>@c.PrecioTotal.ToString("C")</td>
                            <td>
                                <a asp-action="Editar" asp-route-id="@c.Id" class="btn btn-warning btn-sm me-1">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button type="button" class="btn btn-danger btn-sm btn-eliminar" data-id="@c.Id">
                                    <i class="fas fa-trash"></i>
                                </button>
                                <a asp-controller="Pagos" asp-action="PagosPorContrato" asp-route-contratoId="@c.Id" class="btn btn-info btn-sm">
                                    <i class="fas fa-wallet"></i> Pagos
                                </a>
                                <a asp-action="Reporte" asp-route-id="@c.Id" class="btn btn-info btn-sm" target="_blank">
                                    <i class="fas fa-file-alt"></i> Reporte
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- 🔁 Formulario oculto para enviar ID al eliminar -->
<form id="form-eliminar" method="post" asp-action="EliminarConfirmar" style="display:none;">
    <input type="hidden" name="id" id="input-id" />
</form>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#tablaContratos').DataTable({
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'
                }
            });

            // SweetAlert para confirmación al eliminar
            document.querySelectorAll('.btn-eliminar').forEach(button => {
                button.addEventListener('click', function () {
                    const id = this.dataset.id;

                    Swal.fire({
                        title: '¿Estás seguro?',
                        text: "Esta acción no se puede deshacer.",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Sí, eliminar',
                        cancelButtonText: 'Cancelar'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            document.getElementById('input-id').value = id;
                            document.getElementById('form-eliminar').submit();
                        }
                    });
                });
            });
        });
    </script>
}
