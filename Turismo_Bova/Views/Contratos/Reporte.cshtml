@model Turismo_Bova.Models.Contrato
@{
    Layout = null; // sin layout
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Reporte de Contrato</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body onload="window.print()" style="padding: 2rem;">
    <h2 class="text-center mb-4">Reporte de Contrato</h2>

    <table class="table table-bordered">
        <tr><th>ID</th><td>@Model.Id</td></tr>
        <tr><th>Cliente</th><td>@Model.cliente?.RazonSocial</td></tr>
        <tr><th>Servicio</th><td>@Model.servicio?.Nombre</td></tr>
        <tr><th>Fecha Inicio</th><td>@Model.FechaInicio</td></tr>
        <tr><th>Fecha Fin</th><td>@Model.FechaFin</td></tr>
        <tr><th>Estado</th><td>@Model.Estado</td></tr>
        <tr><th>Precio Total</th><td>@Model.PrecioTotal.ToString("C")</td></tr>
    </table>

    <div class="text-end mt-4">
        <button class="btn btn-primary" onclick="window.print()">
            <i class="fas fa-print"></i> Imprimir
        </button>
    </div>
</body>
</html>
