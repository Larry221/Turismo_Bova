@model List<Turismo_Bova.Models.Factura>
@{
    ViewData["Title"] = "Facturas";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between mb-3">
        <h1>Facturas</h1>
        <a asp-action="Crear" class="btn btn-success">
            <i class="fas fa-plus"></i> Generar Factura
        </a>
    </div>

    <div class="card border-primary">
        <div class="card-body">
            <table id="tablaFacturas" class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Factura</th>
                        <th>Cliente</th>
                        <th>Fecha Emisión</th>
                        <th>IGV</th>
                        <th>Total</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model)
                    {
                        <tr>
                            <td>#@f.Id</td>
                            <td>@f.contrato?.cliente?.RazonSocial</td>
                            <td>@f.FechaEmision</td>
                            <td>@f.Igv.ToString("C")</td>
                            <td>@f.Total.ToString("C")</td>
                            <td>@f.EstadoPago</td>
                            <td>
                                <a asp-action="Reporte" asp-route-id="@f.Id" target="_blank" class="btn btn-info btn-sm">
                                    <i class="fas fa-file-alt"></i> Ver Reporte
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#tablaFacturas').DataTable({
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'
                }
            });
        });
    </script>
}
