@model Turismo_Bova.Models.Factura
@{
    Layout = null;
    var pagos = Model.contrato.pago.ToList();
    double subtotal = pagos.Sum(p => p.MontoPagado);
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Factura #@Model.Id</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body onload="window.print()" style="padding: 2rem;">
    <h2 class="text-center mb-4">Factura N° @Model.Id</h2>

    <table class="table table-bordered">
        <tr><th>Cliente</th><td>@Model.contrato?.cliente?.RazonSocial</td></tr>
        <tr><th>Servicio</th><td>@Model.contrato?.servicio?.Nombre</td></tr>
        <tr><th>Fecha Emisión</th><td>@Model.FechaEmision</td></tr>
        <tr><th>Estado de Pago</th><td>@Model.EstadoPago</td></tr>
    </table>

    <h5 class="mt-4">Pagos Realizados</h5>
    <table class="table table-sm table-striped">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Monto</th>
                <th>Método</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in pagos)
            {
                <tr>
                    <td>@p.FechaPago.ToString("yyyy-MM-dd")</td>
                    <td>@p.MontoPagado.ToString("C")</td>
                    <td>@p.MetodoPago</td>
                </tr>
            }
        </tbody>
    </table>

    <h5 class="text-end mt-4">
        Subtotal: @subtotal.ToString("C") <br />
        IGV (18%): @Model.Igv.ToString("C") <br />
        <strong>Total: @Model.Total.ToString("C")</strong>
    </h5>

    <div class="text-end mt-4">
        <button class="btn btn-primary" onclick="window.print()">
            <i class="fas fa-print"></i> Imprimir
        </button>
    </div>
</body>
</html>
