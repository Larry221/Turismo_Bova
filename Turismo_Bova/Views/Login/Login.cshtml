@model Turismo_Bova.ViewModels.Login

@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}


<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap-grid.min.css" rel="stylesheet" />
</head>
<body class="bg-light d-flex justify-content-center align-items-center vh-100 m-0">

    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-sm-6 col-md-4">
                <div class="card shadow-sm">

                    <div class="card-body">

                        <div class="card-img text-center">
                            <img class="rounded-circle mx-auto d-block border shadow" src="~/Imagenes/Turismo_Bova2.jpg" alt="Turismo_Bova"
                                 style="width: 150px; height: 150px; object-fit: cover;" />
                        </div>

                        <h3 class="text-center mt-1 text-primary">TURISMO BOVA</h3>

                        <!-- Mostrar errores generales, agregar arroba delante de Html y class luego de descomentar
                        Html.ValidationSummary(false, "", new { class = "text-danger mb-3" }) -->

                        <form asp-action="Login" method="post">
                            <div class="mb-3 mt-4">
                                <label asp-for="Correo" class="form-label">Correo</label>
                                <input asp-for="Correo" class="form-control" type="email" placeholder="Ingresa tu correo" required />
                                <span asp-validation-for="Correo" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Contraseña" class="form-label">Contraseña</label>
                                <input asp-for="Contraseña" class="form-control" type="password" placeholder="Ingresa tu contraseña" required />
                                <span asp-validation-for="Contraseña" class="text-danger"></span>
                            </div>

                            <div class="d-grid mb-3">
                                <button type="submit" class="btn btn-primary">Iniciar Sesión</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>



</body>
</html>

@section Scripts {

    <script>
        @if (TempData["Mensaje"] != null)
        {
            var tipo = TempData["Tipo"]?.ToString().ToLower() ?? "success";
            <text>
                    Swal.fire({
                        icon: '@tipo', // success, error, warning, info
                        title: '@TempData["Mensaje"]',
                        confirmButtonText: 'Aceptar',
                        timer: 1000,
                        timerProgressBar: true
                    });
            </text>
        }
    </script>
}


