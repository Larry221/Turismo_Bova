@model Turismo_Bova.Models.Mantenimiento
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Reporte de Mantenimiento</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body onload="window.print()" style="padding: 2rem;">
    <h2 class="text-center mb-4">Reporte de Mantenimiento</h2>

    <table class="table table-bordered">
        <tr><th>ID</th><td>@Model.Id</td></tr>
        <tr><th>Tipo</th><td>@Model.TipoMantenimiento</td></tr>
        <tr><th>Descripción</th><td>@Model.Descripcion</td></tr>
        <tr><th>Fecha Inicio</th><td>@Model.FechaInicio</td></tr>
        <tr><th>Fecha Fin</th><td>@Model.FechaFin</td></tr>
        <tr><th>Vehículo</th><td>@Model.vehiculo?.Placa</td></tr>
        <tr><th>Empleado</th><td>@Model.empleado?.Nombre</td></tr>
        <tr><th>Proveedor</th><td>@Model.proveedor?.RazonSocial</td></tr>
    </table>

    <div class="text-end mt-4">
        <button class="btn btn-primary" onclick="window.print()">
            <i class="fas fa-print"></i> Imprimir
        </button>
    </div>
</body>
</html>
