@model Turismo_Bova.Models.Pago
@{
    ViewData["Title"] = "Editar Pago";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <h2>Editar pago</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card border-warning">
        <div class="card-body">
            <form asp-action="Editar" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="FechaPago" class="form-label"></label>
                    <input asp-for="FechaPago" class="form-control" type="date" />
                </div>
                <div class="mb-3">
                    <label asp-for="MontoPagado" class="form-label"></label>
                    <input asp-for="MontoPagado" class="form-control" type="number" step="0.01" />
                </div>
                <div class="mb-3">
                    <label asp-for="MetodoPago" class="form-label"></label>
                    <input asp-for="MetodoPago" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="ContratoId" class="form-label">Contrato</label>
                    <select asp-for="ContratoId" asp-items="ViewBag.ContratoId" class="form-select"></select>
                </div>

                <div class="text-end">
                    <button type="submit" class="btn btn-warning">Actualizar</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>
