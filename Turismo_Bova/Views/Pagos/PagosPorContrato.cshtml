@model List<Turismo_Bova.Models.Pago>
@{
    ViewData["Title"] = "Pagos del Contrato";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var contrato = ViewBag.Contrato as Turismo_Bova.Models.Contrato;
    double totalPagado = ViewBag.TotalPagado;
    double restante = ViewBag.Restante;
}

<div class="container-fluid py-4">
    <h2>Pagos del Contrato N° @contrato.Id</h2>

    <div class="card border-primary mb-4">
        <div class="card-body">
            <h5 class="mb-2"><strong>Cliente:</strong> @contrato.cliente?.RazonSocial</h5>
            <h5 class="mb-2"><strong>Servicio:</strong> @contrato.servicio?.Nombre</h5>
            <h5 class="mb-2"><strong>Precio Total:</strong> @contrato.PrecioTotal.ToString("C")</h5>
            <h5 class="mb-2 text-success"><strong>Total Pagado:</strong> @totalPagado.ToString("C")</h5>
            <h5 class="mb-2 text-danger"><strong>Restante:</strong> @restante.ToString("C")</h5>
        </div>
    </div>

    <div class="d-flex justify-content-between mb-3">
        <h4>Listado de Pagos</h4>
        <a asp-action="Crear" asp-route-contratoId="@contrato.Id" class="btn btn-success">
            <i class="fas fa-plus"></i> Registrar Pago
        </a>
    </div>

    <div class="card border-secondary">
        <div class="card-body">
            <table id="tablaPagosContrato" class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Fecha</th>
                        <th>Monto</th>
                        <th>Método</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>@p.Id</td>
                            <td>@p.FechaPago.ToString("yyyy-MM-dd")</td>
                            <td>@p.MontoPagado.ToString("C")</td>
                            <td>@p.MetodoPago</td>
                            <td>
                                <a asp-action="Editar" asp-route-id="@p.Id" class="btn btn-warning btn-sm me-1">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button type="button" class="btn btn-danger btn-sm btn-eliminar" data-id="@p.Id">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <a asp-controller="Contratos" asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i> Volver a Contratos
        </a>
    </div>
</div>

<!-- 🔁 Formulario oculto para eliminar -->
<form id="form-eliminar" method="post" asp-action="EliminarConfirmar" style="display:none;">
    <input type="hidden" name="id" id="input-id" />
</form>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#tablaPagosContrato').DataTable({
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'
                }
            });

            // Confirmación de eliminación con SweetAlert
            document.querySelectorAll('.btn-eliminar').forEach(button => {
                button.addEventListener('click', function () {
                    const id = this.dataset.id;

                    Swal.fire({
                        title: '¿Eliminar este pago?',
                        text: "Esta acción no se puede deshacer.",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Sí, eliminar',
                        cancelButtonText: 'Cancelar'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            document.getElementById('input-id').value = id;
                            document.getElementById('form-eliminar').submit();
                        }
                    });
                });
            });
        });
    </script>
}
