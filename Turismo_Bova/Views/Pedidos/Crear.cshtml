@model Turismo_Bova.Models.Pedido

@{
    ViewData["Title"] = "Crear Pedido";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var proveedores = (List<Turismo_Bova.Models.Proveedor>)ViewBag.Proveedores;
    var productos = (List<Turismo_Bova.ViewModels.ProductoSimple>)ViewBag.Productos;
}

<div class="container-fluid py-4">
    <!-- Encabezado -->
    <div class="dashboard-header mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1>Registrar nuevo pedido</h1>
                <p class="mb-0">Complete los datos del pedido</p>
            </div>
            <div>
                <span class="badge bg-light text-dark">
                    <i class="bi bi-calendar me-2"></i>
                    <span id="current-date"></span>
                </span>
            </div>
        </div>
    </div>

    <!-- Mostrar errores de validación generales -->
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

    <!-- Formulario -->
    <form asp-action="Crear" method="post">
        <div class="row">
            <div class="col-md-6">
                <div class="card card-facturas">
                    <div class="card-body">
                        <h4 class="mb-3">Datos del Pedido</h4>

                        <div class="mb-3">
                            <label asp-for="Descripcion" class="form-label"></label>
                            <input asp-for="Descripcion" class="form-control" />
                            <span asp-validation-for="Descripcion" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FechaPedido" class="form-label"></label>
                            <input asp-for="FechaPedido" type="date" class="form-control" />
                            <span asp-validation-for="FechaPedido" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Estado" class="form-label"></label>
                            <select asp-for="Estado" class="form-select">
                                <option value="">-- Seleccionar estado --</option>
                                <option value="Pendiente">Pendiente</option>
                                <option value="Procesado">Procesado</option>
                                <option value="Entregado">Entregado</option>
                            </select>
                            <span asp-validation-for="Estado" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ProveedorId" class="form-label"></label>
                            <select asp-for="ProveedorId" asp-items="@(new SelectList(proveedores, "Id", "RazonSocial"))" class="form-select">
                                <option value="">-- Seleccionar proveedor --</option>
                            </select>
                            <span asp-validation-for="ProveedorId" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Productos dinámicos -->
            <div class="col-md-6">
                <div class="card card-facturas">
                    <div class="card-body">
                        <h4 class="mb-3">Productos</h4>
                        <div id="productos-container">
                            <div class="producto-item row mb-2">
                                <div class="col-8">
                                    <select name="productoIds" class="form-select" required>
                                        <option value="">-- Seleccionar producto --</option>
                                        @foreach (var p in productos)
                                        {
                                            <option value="@p.Id">@p.Nombre</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-4">
                                    <input type="number" name="cantidades" class="form-control" placeholder="Cantidad" min="1" required />
                                </div>
                            </div>
                        </div>

                        <button type="button" class="btn btn-outline-secondary btn-sm mt-2" onclick="agregarProducto()">
                            <i class="fas fa-plus me-1"></i> Agregar otro producto
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-end mt-3">
            <button type="submit" class="btn btn-success">
                <i class="fas fa-save me-1"></i> Registrar Pedido
            </button>
            <a asp-controller="Pedidos" asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-1"></i> Volver
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const productos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(productos));

        function agregarProducto() {
            const container = document.getElementById('productos-container');
            const div = document.createElement('div');
            div.className = 'producto-item row mb-2';
            div.innerHTML = `
                <div class="col-8">
                    <select name="productoIds" class="form-select" required>
                        <option value="">-- Seleccionar producto --</option>
                        ${productos.map(p => `<option value="${p.Id}">${p.Nombre}</option>`).join('')}
                    </select>
                </div>
                <div class="col-4">
                    <input type="number" name="cantidades" class="form-control" placeholder="Cantidad" min="1" required />
                </div>
            `;
            container.appendChild(div);
        }

        // Fecha actual
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            document.getElementById('current-date').textContent = new Date().toLocaleDateString('es-ES', options);
    </script>

}
