@model Turismo_Bova.Models.Ruta
@{
    ViewData["Title"] = "Registrar Ruta";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <h2>Registrar nueva ruta</h2>
    <div class="card border-success">
        <div class="card-body">
            <form asp-action="Crear" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="Origen" class="form-label"></label>
                    <input asp-for="Origen" class="form-control" maxlength="50" required />
                    <span asp-validation-for="Origen" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Destino" class="form-label"></label>
                    <input asp-for="Destino" class="form-control" maxlength="50" required />
                    <span asp-validation-for="Destino" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DistanciaKm" class="form-label"></label>
                    <input asp-for="DistanciaKm" class="form-control" type="number" step="0.01" min="0.1" required />
                    <span asp-validation-for="DistanciaKm" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DuracionEstimada" class="form-label"></label>
                    <input asp-for="DuracionEstimada" class="form-control" placeholder="Ejemplo: 02:30" pattern="^\d{1,2}:\d{2}$" required />
                    <span asp-validation-for="DuracionEstimada" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ServicioId" class="form-label">Servicio</label>
                    <select asp-for="ServicioId" class="form-select" asp-items="ViewBag.ServicioId" required>
                        <option value="">Seleccione un servicio</option>
                    </select>
                    <span asp-validation-for="ServicioId" class="text-danger"></span>
                </div>

                <div class="text-end">
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-save me-1"></i> Guardar
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
