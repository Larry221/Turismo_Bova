@model Turismo_Bova.Models.Tarea
@{
    ViewData["Title"] = "Crear Tarea";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <h2>Registrar nueva tarea</h2>

    <div class="card border-success col-6">
        <div class="card-body">
            <form asp-action="Crear" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label"></label>
                    <textarea asp-for="Descripcion" class="form-control"></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FechaAsignacion" class="form-label"></label>
                    <input asp-for="FechaAsignacion" class="form-control" type="date" />
                    <span asp-validation-for="FechaAsignacion" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Estado" class="form-label"></label>
                    <input asp-for="Estado" class="form-control" />
                    <span asp-validation-for="Estado" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EmpleadoId" class="form-label">Empleado</label>
                    <select asp-for="EmpleadoId" asp-items="ViewBag.EmpleadoId" class="form-select"></select>
                    <span asp-validation-for="EmpleadoId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MantenimientoId" class="form-label">Mantenimiento</label>
                    <select asp-for="MantenimientoId" asp-items="ViewBag.MantenimientoId" class="form-select"></select>
                    <span asp-validation-for="MantenimientoId" class="text-danger"></span>
                </div>

                <div class="text-end">
                    <button type="submit" class="btn btn-success">Guardar</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
