@model Turismo_Bova.Models.Tarea
@{
    ViewData["Title"] = "Editar Tarea";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <h2>Editar tarea</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card border-warning">
        <div class="card-body">
            <form asp-action="Editar" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label"></label>
                    <textarea asp-for="Descripcion" class="form-control"></textarea>
                </div>
                <div class="mb-3">
                    <label asp-for="FechaAsignacion" class="form-label"></label>
                    <input asp-for="FechaAsignacion" class="form-control" type="date" />
                </div>
                <div class="mb-3">
                    <label asp-for="Estado" class="form-label"></label>
                    <input asp-for="Estado" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="EmpleadoId" class="form-label">Empleado</label>
                    <select asp-for="EmpleadoId" asp-items="ViewBag.EmpleadoId" class="form-select"></select>
                </div>
                <div class="mb-3">
                    <label asp-for="MantenimientoId" class="form-label">Mantenimiento</label>
                    <select asp-for="MantenimientoId" asp-items="ViewBag.MantenimientoId" class="form-select"></select>
                </div>

                <div class="text-end">
                    <button type="submit" class="btn btn-warning">Actualizar</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>
