@model Turismo_Bova.Models.Tarea
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Reporte de Tarea</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body onload="window.print()" style="padding: 2rem;">
    <h2 class="text-center mb-4">Reporte de Tarea</h2>

    <table class="table table-bordered">
        <tr><th>ID</th><td>@Model.Id</td></tr>
        <tr><th>Nombre</th><td>@Model.Nombre</td></tr>
        <tr><th>Descripción</th><td>@Model.Descripcion</td></tr>
        <tr><th>Fecha Asignación</th><td>@Model.FechaAsignacion</td></tr>
        <tr><th>Estado</th><td>@Model.Estado</td></tr>
        <tr><th>Empleado Asignado</th><td>@Model.empleado?.Nombre</td></tr>
        <tr><th>Mantenimiento Asociado</th><td>@Model.mantenimiento?.TipoMantenimiento</td></tr>
    </table>

    <div class="text-end mt-4">
        <button class="btn btn-primary" onclick="window.print()">
            <i class="fas fa-print"></i> Imprimir
        </button>
    </div>
</body>
</html>
