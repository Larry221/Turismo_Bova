@model Turismo_Bova.Models.Usuario

@{
    ViewData["Title"] = "Crear - Usuario";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/Dashboard.css" />
</head>
<body>
    <div class="container-fluid py-4">
        <div class="dashboard-header mb-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1>Crear nuevo usuario</h1>
                </div>
                <div>
                    <span class="badge bg-light text-dark">
                        <i class="bi bi-calendar me-2"></i>
                        <span id="current-date"></span>
                    </span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="card card-usuarios">
                    <div class="card-body">
                        <form asp-controller="Usuarios" asp-action="Crear" method="post">
                            <div class="mb-3">
                                <label class="form-label">Tipo de usuario</label>
                                <select id="tipoUsuario" class="form-control" required>
                                    <option value="">-- Selecciona una opción --</option>
                                    <option value="empleado">Empleado</option>
                                    <option value="cliente">Cliente</option>
                                </select>
                            </div>

                            <div class="mb-3" id="grupoEmpleado" style="display: none;">
                                <label asp-for="EmpleadoId" class="form-label">Empleado</label>
                                <select asp-for="EmpleadoId" class="form-control">
                                    <option value="">-- Selecciona un empleado --</option>
                                    @foreach (var emp in ViewBag.Empleados as List<SelectListItem>)
                                    {
                                        <option value="@emp.Value">@emp.Text</option>
                                    }
                                </select>
                            </div>

                            <div class="mb-3" id="grupoCliente" style="display: none;">
                                <label asp-for="ClienteId" class="form-label">Cliente</label>
                                <select asp-for="ClienteId" class="form-control">
                                    <option value="">-- Selecciona un cliente --</option>
                                    @foreach (var cli in ViewBag.Clientes as List<SelectListItem>)
                                    {
                                        <option value="@cli.Value">@cli.Text</option>
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Nombre" class="form-label">Nombre</label>
                                <input asp-for="Nombre" class="form-control" required />
                                <span asp-validation-for="Nombre" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Correo" class="form-label">Correo</label>
                                <input asp-for="Correo" class="form-control" required />
                                <span asp-validation-for="Correo" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Contraseña" class="form-label">Contraseña</label>
                                <input asp-for="Contraseña" type="password" class="form-control" required />
                                <span asp-validation-for="Contraseña" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="RolId" class="form-label">Rol</label>
                                <select asp-for="RolId" asp-items="ViewBag.Roles" class="form-control" required>
                                    <option value="">-- Selecciona un rol --</option>
                                </select>
                                <span asp-validation-for="RolId" class="text-danger small"></span>
                            </div>
                            

                            <div class="text-end">
                                <button type="submit" class="btn btn-success">
                                    <i class="fas fa-save me-1"></i> Guardar
                                </button>
                                <a asp-controller="Usuarios" asp-action="Index" class="btn btn-secondary">
                                    <i class="fas fa-arrow-left me-1"></i> Volver
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const tipoUsuario = document.getElementById("tipoUsuario");
            const grupoEmpleado = document.getElementById("grupoEmpleado");
            const grupoCliente = document.getElementById("grupoCliente");

            tipoUsuario.addEventListener("change", function () {
                const tipo = tipoUsuario.value;

                if (tipo === "empleado") {
                    grupoEmpleado.style.display = "block";
                    grupoCliente.style.display = "none";
                } else if (tipo === "cliente") {
                    grupoEmpleado.style.display = "none";
                    grupoCliente.style.display = "block";
                } else {
                    grupoEmpleado.style.display = "none";
                    grupoCliente.style.display = "none";
                }
            });
        });
    </script>


    <script>
        const empleados = @Html.Raw(ViewBag.EmpleadosCorreo);
        const clientes = @Html.Raw(ViewBag.ClientesCorreo);

        const correoInput = document.querySelector('input[name="Correo"]');
        const empleadoSelect = document.querySelector('select[name="EmpleadoId"]');
        const clienteSelect = document.querySelector('select[name="ClienteId"]');

        empleadoSelect.addEventListener("change", function () {
            const seleccionado = empleados.find(e => e.Id == this.value);
            if (seleccionado) {
                correoInput.value = seleccionado.Correo;
            }
        });

        clienteSelect.addEventListener("change", function () {
            const seleccionado = clientes.find(c => c.Id == this.value);
            if (seleccionado) {
                correoInput.value = seleccionado.Correo;
            }
        });
    </script>



    <script>
        // Mostrar fecha actual
        const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        document.getElementById('current-date').textContent = new Date().toLocaleDateString('es-ES', options);

        @if (TempData["Mensaje"] != null)
        {
            var tipo = TempData["Tipo"]?.ToString().ToLower() ?? "success";
                <text>
                    document.addEventListener('DOMContentLoaded', function() {
                        Swal.fire({
                            icon: '@tipo',
                            title: '@TempData["Mensaje"]',
                            confirmButtonText: 'Aceptar',
                            timer: 2000,
                            timerProgressBar: true,
                            background: '#fff',
                            backdrop: `
                                rgba(0,0,0,0.03)
                                url("/images/confetti.gif")
                                left top
                                no-repeat
                            `
                        });
                    });
                </text>
        }
    </script>
</body>
</html>
